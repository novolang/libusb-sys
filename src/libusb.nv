// The C entry points of libusb-1.0, one novo-lang declaration each.
//
// A pointer is an `Int`: the C API hands out four opaque handles, the
// session `libusb_context*`, the device `libusb_device*`, the open
// device `libusb_device_handle*` and the device list, which is an
// array of device pointers.  This module carries each of them as the
// address the C library returned.  Zero is the null pointer, and a
// null context selects the default session libusb creates for a
// process that never asked for one.
//
// An out-parameter is the address of a slot the caller owns.
// `ptr.alloc_word` returns the address of an eight-byte slot, which is
// the width libusb writes for a context, a handle or a list, and
// `ptr.read_word` reads it back.
//
// A descriptor is a structure behind a pointer, and the caller lays
// out the bytes.  The README's "The rules a user needs" gives the byte
// offsets of the two this package reads.
//
// A `const char *` return value is an address the library owns.  Read
// it with `ptr.read_str` and do not free it.
//
// EVERY ENTRY POINT THAT ANSWERS A STATUS ANSWERS A NEGATIVE NUMBER ON
// FAILURE, and a C `int` return arrives in 32 bits.  Bind the value to
// a local with `as i32` before comparing it with a negative number.
// An entry point that answers one byte — the bus number, the device
// address — answers it in one byte, and the bits above it are not
// cleared: write `% 256` before comparing.
//
// The asynchronous interface is not here.  A `libusb_transfer` carries
// a C FUNCTION POINTER the caller fills in, and so does every hotplug
// and polling call.  The README's "What is not included" section lists
// them.

// Start a libusb session.
//
// `ctx` is the address of an eight-byte slot the session handle is
// written into, or 0 to initialise the default session instead.
// Answers 0 on success and a negative error code otherwise.
pub @ffi(library = "usb-1.0", symbol = "libusb_init")
fn libusb_init(ctx: Int) -> Int [io, ffi]

// End a libusb session.
//
// Every device list, device handle and device reference taken from the
// session must be released first.  Passing 0 ends the default session.
pub @ffi(library = "usb-1.0", symbol = "libusb_exit")
fn libusb_exit(ctx: Int) [io, ffi]

// Set the logging verbosity of a session.
//
// `level` is 0 for nothing, 1 for errors, 2 for warnings, 3 for
// information and 4 for everything.  Messages go to the standard error
// stream.
pub @ffi(library = "usb-1.0", symbol = "libusb_set_debug")
fn libusb_set_debug(ctx: Int, level: Int) [io, ffi]

// Get the version of the library.
//
// The answer is the address of a structure the library owns: four
// two-byte numbers — major, minor, micro and nano — followed by two
// addresses, the release-candidate suffix and the describe string.
pub @ffi(library = "usb-1.0", symbol = "libusb_get_version")
fn libusb_get_version() -> Int [ffi]

// Ask whether this build of the library has a capability.
//
// `capability` is 0x0000 for the capability query itself, 0x0100 for
// hotplug, 0x0101 for the kernel driver calls and 0x0102 for detaching
// a kernel driver automatically.  Answers 1 when it does.
pub @ffi(library = "usb-1.0", symbol = "libusb_has_capability")
fn libusb_has_capability(capability: Int) -> Int [ffi]

// Set the language the error strings are written in.
//
// `locale` is a two-letter language code, optionally with a region,
// such as `"en"` or `"de-DE"`.  Answers 0 on success, -12 when the
// language is not one the library was built with and -5 when the
// string is malformed.
pub @ffi(library = "usb-1.0", symbol = "libusb_setlocale")
fn libusb_setlocale(locale: Str) -> Int [io, ffi]

// Get the short name of an error code.
//
// The answer is the address of a static string the library owns, such
// as `"LIBUSB_ERROR_ACCESS"`.  Zero answers
// `"LIBUSB_SUCCESS / LIBUSB_TRANSFER_COMPLETED"`, because zero is both
// of those.  A number that is neither answers `"**UNKNOWN**"`.
pub @ffi(library = "usb-1.0", symbol = "libusb_error_name")
fn libusb_error_name(errcode: Int) -> Int [ffi]

// Get the sentence describing an error code.
//
// The answer is the address of a static string the library owns, in
// the language `libusb_setlocale` chose.
pub @ffi(library = "usb-1.0", symbol = "libusb_strerror")
fn libusb_strerror(errcode: Int) -> Int [ffi]

// Get the list of devices attached to the system.
//
// `list` is the address of an eight-byte slot the array of device
// pointers is written into, and the array holds one address every
// eight bytes.  Answers the number of devices, which may be 0, or a
// negative error code.  `libusb_free_device_list` releases the array.
pub @ffi(library = "usb-1.0", symbol = "libusb_get_device_list")
fn libusb_get_device_list(ctx: Int, list: Int) -> Int [io, ffi]

// Release a device list.
//
// `unref_devices` is 1 to drop the reference the list holds on every
// device in it, which is what a caller that kept none of them wants,
// and 0 to leave the references alone.
pub @ffi(library = "usb-1.0", symbol = "libusb_free_device_list")
fn libusb_free_device_list(list: Int, unref_devices: Int) [io, ffi]

// Take a reference on a device.
//
// Answers the same device.  A device stays alive while any reference
// to it does, which is how a program keeps one device out of a list it
// is about to free.
pub @ffi(library = "usb-1.0", symbol = "libusb_ref_device")
fn libusb_ref_device(dev: Int) -> Int [ffi]

// Drop a reference on a device.
//
// The device is destroyed when the last reference goes.
pub @ffi(library = "usb-1.0", symbol = "libusb_unref_device")
fn libusb_unref_device(dev: Int) [ffi]

// Get the number of the bus a device is on.
//
// The answer is ONE BYTE, and the bits above it are not cleared.
// Write `% 256` before comparing it with a number.
pub @ffi(library = "usb-1.0", symbol = "libusb_get_bus_number")
fn libusb_get_bus_number(dev: Int) -> Int [ffi]

// Get the address a device has on its bus.
//
// The answer is one byte, as the bus number is.  A bus number and an
// address together identify a device while it stays plugged in.
pub @ffi(library = "usb-1.0", symbol = "libusb_get_device_address")
fn libusb_get_device_address(dev: Int) -> Int [ffi]

// Get the number of the port a device is plugged into.
//
// Answers 0 when the device is a root hub, which is plugged into
// nothing.
pub @ffi(library = "usb-1.0", symbol = "libusb_get_port_number")
fn libusb_get_port_number(dev: Int) -> Int [ffi]

// Write the chain of port numbers from the root hub to a device.
//
// `port_numbers` is a buffer of `port_numbers_len` bytes, and seven is
// enough for any chain the USB specification allows.  Answers the
// number of ports written, or -2 when the buffer is too small.
pub @ffi(library = "usb-1.0", symbol = "libusb_get_port_numbers")
fn libusb_get_port_numbers(dev: Int, port_numbers: Int, port_numbers_len: Int) -> Int [ffi]

// Get the hub a device is plugged into.
//
// Answers 0 for a root hub.  The answer is valid only while the device
// list the device came from is still alive.
pub @ffi(library = "usb-1.0", symbol = "libusb_get_parent")
fn libusb_get_parent(dev: Int) -> Int [ffi]

// Get the speed a device is running at.
//
// Answers 0 when the speed is unknown, 1 for low speed, 2 for full
// speed, 3 for high speed, 4 for SuperSpeed and 5 for SuperSpeed+.
pub @ffi(library = "usb-1.0", symbol = "libusb_get_device_speed")
fn libusb_get_device_speed(dev: Int) -> Int [ffi]

// Get the largest packet an endpoint of a device will carry.
//
// `endpoint` is the endpoint address out of its descriptor.  Answers
// the size in bytes, or -5 when no descriptor declares that endpoint.
// ENDPOINT ZERO IS DECLARED BY NO DESCRIPTOR: every device has it, and
// byte 7 of the device descriptor is where its packet size lives, so
// this call answers -5 for it.
pub @ffi(library = "usb-1.0", symbol = "libusb_get_max_packet_size")
fn libusb_get_max_packet_size(dev: Int, endpoint: Int) -> Int [ffi]

// Get the bytes an isochronous endpoint will carry in one microframe.
//
// This is the packet size multiplied by the number of transactions per
// microframe, which is what an isochronous transfer must be sized
// against.  It reads the endpoint descriptors, so it answers -5 for an
// endpoint no descriptor declares.
pub @ffi(library = "usb-1.0", symbol = "libusb_get_max_iso_packet_size")
fn libusb_get_max_iso_packet_size(dev: Int, endpoint: Int) -> Int [ffi]

// Read a device's device descriptor.
//
// `desc` is the address of eighteen bytes the caller owns, and libusb
// writes the descriptor into them.  The layout is the one the USB
// specification gives for a device descriptor, and the README lists
// the offsets.  Answers 0 on success; the descriptor is cached, so the
// call reaches no hardware and needs no privileges.
pub @ffi(library = "usb-1.0", symbol = "libusb_get_device_descriptor")
fn libusb_get_device_descriptor(dev: Int, desc: Int) -> Int [ffi]

// Read the configuration descriptor a device is currently using.
//
// `config` is the address of an eight-byte slot the descriptor's
// address is written into.  Answers 0 on success and -5 when the
// device is not configured.  `libusb_free_config_descriptor` releases
// what it gives.
pub @ffi(library = "usb-1.0", symbol = "libusb_get_active_config_descriptor")
fn libusb_get_active_config_descriptor(dev: Int, config: Int) -> Int [io, ffi]

// Read one of a device's configuration descriptors by index.
//
// `config_index` is between zero and the configuration count in the
// device descriptor.  Answers 0 on success and -5 when there is no
// such configuration.
pub @ffi(library = "usb-1.0", symbol = "libusb_get_config_descriptor")
fn libusb_get_config_descriptor(dev: Int, config_index: Int, config: Int) -> Int [io, ffi]

// Release a configuration descriptor.
pub @ffi(library = "usb-1.0", symbol = "libusb_free_config_descriptor")
fn libusb_free_config_descriptor(config: Int) [ffi]

// Open a device.
//
// `handle` is the address of an eight-byte slot the open handle is
// written into.  Answers 0 on success, -3 when the process may not
// open the device and -4 when the device has been unplugged.  THIS IS
// THE CALL THAT NEEDS PRIVILEGES: everything above it reads what the
// operating system already knows.
pub @ffi(library = "usb-1.0", symbol = "libusb_open")
fn libusb_open(dev: Int, handle: Int) -> Int [io, ffi]

// Close an open device.
//
// Every interface claimed on the handle must be released first.
pub @ffi(library = "usb-1.0", symbol = "libusb_close")
fn libusb_close(dev_handle: Int) [io, ffi]

// Open the first device with a vendor and product identifier.
//
// Answers the handle, or 0 when no such device is attached or the
// process may not open it — the two cases are not told apart, which is
// why this call is for a program that knows its own device and not for
// one that is looking.
pub @ffi(library = "usb-1.0", symbol = "libusb_open_device_with_vid_pid")
fn libusb_open_device_with_vid_pid(ctx: Int, vendor_id: Int, product_id: Int) -> Int [io, ffi]

// Get the device an open handle belongs to.
//
// The answer takes no new reference, and it lives as long as the
// handle does.
pub @ffi(library = "usb-1.0", symbol = "libusb_get_device")
fn libusb_get_device(dev_handle: Int) -> Int [ffi]

// Get the configuration a device is currently in.
//
// `config` is the address of a four-byte slot the configuration value
// is written into, and 0 means the device is not configured.
pub @ffi(library = "usb-1.0", symbol = "libusb_get_configuration")
fn libusb_get_configuration(dev_handle: Int, config: Int) -> Int [io, ffi]

// Put a device into a configuration.
//
// `configuration` is a value out of a configuration descriptor, and -1
// unconfigures the device.  No interface may be claimed when this is
// called.
pub @ffi(library = "usb-1.0", symbol = "libusb_set_configuration")
fn libusb_set_configuration(dev_handle: Int, configuration: Int) -> Int [io, ffi]

// Claim an interface on an open device.
//
// A program must claim an interface before any transfer on it.
// Answers 0 on success, -4 when the device is gone, -6 when another
// program holds the interface and -12 when a kernel driver does.
pub @ffi(library = "usb-1.0", symbol = "libusb_claim_interface")
fn libusb_claim_interface(dev_handle: Int, interface_number: Int) -> Int [io, ffi]

// Release an interface on an open device.
//
// This sends a control message, so it can fail.
pub @ffi(library = "usb-1.0", symbol = "libusb_release_interface")
fn libusb_release_interface(dev_handle: Int, interface_number: Int) -> Int [io, ffi]

// Choose the alternate setting of a claimed interface.
//
// An interface has one or more settings, and the endpoints and their
// bandwidth differ between them.
pub @ffi(library = "usb-1.0", symbol = "libusb_set_interface_alt_setting")
fn libusb_set_interface_alt_setting(dev_handle: Int, interface_number: Int,
                                    alternate_setting: Int) -> Int [io, ffi]

// Clear the halt condition on an endpoint.
//
// An endpoint halts after a transfer fails, and refuses everything
// until this is called.  It also resets the endpoint's data toggle.
pub @ffi(library = "usb-1.0", symbol = "libusb_clear_halt")
fn libusb_clear_halt(dev_handle: Int, endpoint: Int) -> Int [io, ffi]

// Reset a device.
//
// Answers 0 when the device came back as it was, and -4 when it came
// back different or did not come back: the handle is then useless and
// the device must be found and opened again.
pub @ffi(library = "usb-1.0", symbol = "libusb_reset_device")
fn libusb_reset_device(dev_handle: Int) -> Int [io, ffi]

// Ask whether a kernel driver holds an interface.
//
// Answers 1 when one does.  Answers -98 on an operating system that
// has no such notion.
pub @ffi(library = "usb-1.0", symbol = "libusb_kernel_driver_active")
fn libusb_kernel_driver_active(dev_handle: Int, interface_number: Int) -> Int [io, ffi]

// Take an interface away from the kernel driver holding it.
//
// The driver gets it back with `libusb_attach_kernel_driver`, or when
// the device is closed if the automatic detach is on.
pub @ffi(library = "usb-1.0", symbol = "libusb_detach_kernel_driver")
fn libusb_detach_kernel_driver(dev_handle: Int, interface_number: Int) -> Int [io, ffi]

// Give an interface back to its kernel driver.
pub @ffi(library = "usb-1.0", symbol = "libusb_attach_kernel_driver")
fn libusb_attach_kernel_driver(dev_handle: Int, interface_number: Int) -> Int [io, ffi]

// Detach and reattach the kernel driver around every claim.
//
// `enable` is 1 to turn it on.  It is what a program that only wants
// its own device to work should do, and it needs the capability
// 0x0102.
pub @ffi(library = "usb-1.0", symbol = "libusb_set_auto_detach_kernel_driver")
fn libusb_set_auto_detach_kernel_driver(dev_handle: Int, enable: Int) -> Int [io, ffi]

// Read a string descriptor and write it out as ASCII.
//
// `desc_index` is a string index out of another descriptor, and 0 is
// not a string.  `data` is a buffer of `length` bytes.  Answers the
// number of bytes written, or a negative error code.  The device is
// asked, so this needs an open handle.
pub @ffi(library = "usb-1.0", symbol = "libusb_get_string_descriptor_ascii")
fn libusb_get_string_descriptor_ascii(dev_handle: Int, desc_index: Int, data: Int,
                                      length: Int) -> Int [io, ffi]

// Perform a control transfer.
//
// `bm_request_type` carries the direction in its top bit: 0x80 reads
// and 0x00 writes.  `data` is a buffer of `w_length` bytes, and
// `timeout` is in milliseconds, where 0 waits for ever.  Answers the
// number of bytes transferred, or a negative error code — -7 for a
// timeout, -9 when the endpoint halted.
pub @ffi(library = "usb-1.0", symbol = "libusb_control_transfer")
fn libusb_control_transfer(dev_handle: Int, bm_request_type: Int, b_request: Int, w_value: Int,
                           w_index: Int, data: Int, w_length: Int, timeout: Int) -> Int [io, ffi]

// Perform a bulk transfer.
//
// `endpoint` carries the direction in its top bit, as the request type
// does.  `transferred` is the address of a four-byte slot the byte
// count is written into, and it is written even when the call fails,
// which is how a program finds what a timeout got through.  Answers 0
// on success.
pub @ffi(library = "usb-1.0", symbol = "libusb_bulk_transfer")
fn libusb_bulk_transfer(dev_handle: Int, endpoint: Int, data: Int, length: Int, transferred: Int,
                        timeout: Int) -> Int [io, ffi]

// Perform an interrupt transfer.
//
// The arguments are those of `libusb_bulk_transfer`.  The difference is
// the endpoint: an interrupt endpoint is polled on a schedule the
// device asked for, and a bulk endpoint is not.
pub @ffi(library = "usb-1.0", symbol = "libusb_interrupt_transfer")
fn libusb_interrupt_transfer(dev_handle: Int, endpoint: Int, data: Int, length: Int,
                             transferred: Int, timeout: Int) -> Int [io, ffi]
